APP_NAME=notification-service
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_PORT=8000
DEBUG=true

POSTGRES_DB=notification-service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notification-service

SQL_ECHO=false

KAFKA_BROKERS=kafka:9092
KAFKA_PUBLISH_TIMEOUT_SECONDS=7.0
